<Project>
  <Target Name="DeployMod" AfterTargets="Build" Condition="'$(ModInstallSubDir)' != '' and ('$(Configuration)' == 'Release' or '$(SptGameDir)' != '')">
    <PropertyGroup>
      <ModDeployRoot Condition="'$(Configuration)' == 'Release'">$(ReleaseStagingDir)</ModDeployRoot>
      <ModDeployRoot Condition="'$(Configuration)' != 'Release'">$(SptGameDir)\</ModDeployRoot>
      <ModDeployDir>$(ModDeployRoot)$(ModInstallSubDir)\</ModDeployDir>
    </PropertyGroup>

    <ItemGroup>
      <ModDeployFiles Include="$(TargetDir)**\*" />
      <ModDeployFiles Remove="$(TargetDir)$(ModDebugDeploySkip)" Condition="'$(Configuration)' != 'Release' and '$(ModDebugDeploySkip)' != ''" />
      <!-- The game's data\config.json is edited there (Dashboard Settings tab): Debug builds only create it -->
      <ModDeployFiles Remove="$(TargetDir)data\config.json" Condition="'$(Configuration)' != 'Release' and Exists('$(ModDeployDir)data\config.json')" />
    </ItemGroup>

    <Copy SourceFiles="@(ModDeployFiles)"
          DestinationFiles="@(ModDeployFiles->'$(ModDeployDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Message Importance="High" Text="$(MSBuildProjectName) -> $(ModDeployDir)" />
  </Target>

  <Target Name="WarnNoDeploy" AfterTargets="Build" Condition="'$(ModInstallSubDir)' != '' and '$(Configuration)' != 'Release' and '$(SptGameDir)' == ''">
    <Warning Text="SptGameDir is not set: $(MSBuildProjectName) was built but not copied into the game." />
  </Target>
</Project>
