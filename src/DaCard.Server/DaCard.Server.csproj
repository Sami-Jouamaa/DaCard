<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DaCard.Server</RootNamespace>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>

    <ModInstallSubDir>SPT_Runtime\user\mods\$(ModAuthor)-$(ModName)</ModInstallSubDir>
    <ModDebugDeploySkip>data\*\**</ModDebugDeploySkip>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.12" GeneratePathProperty="true" />
    <PackageReference Include="SPTushonka.Common" Version="$(SptPackageVersion)" />
    <PackageReference Include="SPTushonka.DI" Version="$(SptPackageVersion)" />
    <PackageReference Include="SPTushonka.Server.Core" Version="$(SptPackageVersion)" />
    <PackageReference Include="SPTushonka.Reflection" Version="$(SptPackageVersion)" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="SQLitePCLRaw.core" Version="2.1.12" GeneratePathProperty="true" />
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.12" GeneratePathProperty="true" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="bundles\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Remove="data\**" />
    <Content Update="bundles.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="traders\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Remove="defaults\**" />
    <Content Include="defaults\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopySqlite" AfterTargets="Build" BeforeTargets="DeployMod">
    <PropertyGroup>
      <SqliteNative>$(PkgSQLitePCLRaw_lib_e_sqlite3)\runtimes</SqliteNative>
    </PropertyGroup>
    <ItemGroup>
      <SqliteManaged Include="$(PkgMicrosoft_Data_Sqlite_Core)\lib\net8.0\Microsoft.Data.Sqlite.dll" />
      <SqliteManaged Include="$(PkgSQLitePCLRaw_core)\lib\netstandard2.0\SQLitePCLRaw.core.dll" />
      <SqliteManaged Include="$(PkgSQLitePCLRaw_provider_e_sqlite3)\lib\net6.0\SQLitePCLRaw.provider.e_sqlite3.dll" />
      <SqliteNativeFile Include="$(SqliteNative)\win-x64\native\e_sqlite3.dll" Rid="win-x64" />
      <SqliteNativeFile Include="$(SqliteNative)\linux-x64\native\libe_sqlite3.so" Rid="linux-x64" />
      <SqliteNativeFile Include="$(SqliteNative)\linux-arm64\native\libe_sqlite3.so" Rid="linux-arm64" />
      <SqliteNativeFile Include="$(SqliteNative)\osx-x64\native\libe_sqlite3.dylib" Rid="osx-x64" />
      <SqliteNativeFile Include="$(SqliteNative)\osx-arm64\native\libe_sqlite3.dylib" Rid="osx-arm64" />
    </ItemGroup>
    <Error Condition="!Exists('%(SqliteManaged.FullPath)')" Text="%(SqliteManaged.FullPath) was not found (run dotnet restore)." />
    <Error Condition="!Exists('%(SqliteNativeFile.FullPath)')" Text="%(SqliteNativeFile.FullPath) was not found (run dotnet restore)." />
    <Copy SourceFiles="@(SqliteManaged)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(SqliteNativeFile)" DestinationFiles="@(SqliteNativeFile->'$(TargetDir)runtimes\%(Rid)\native\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="BuildDashboard" AfterTargets="Build" BeforeTargets="DeployMod;NoJsInMod">
    <PropertyGroup>
      <DashboardSrc>$(MSBuildThisFileDirectory)..\DaCard.Dashboard</DashboardSrc>
      <DashboardOut>$(TargetDir.TrimEnd('\'))</DashboardOut>
    </PropertyGroup>
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(DashboardSrc)" Condition="!Exists('$(DashboardSrc)\node_modules\esbuild')" />
    <Exec Command="node build.mjs --mod &quot;$(DashboardOut)&quot;" WorkingDirectory="$(DashboardSrc)" />
  </Target>

  <Target Name="NoJsInMod" BeforeTargets="DeployMod">
    <ItemGroup>
      <StrayJs Include="$(TargetDir)**\*.js;$(TargetDir)**\*.ts" />
    </ItemGroup>
    <Error Condition="'@(StrayJs)' != ''" Text="SPT would refuse to load the mod because of these .js/.ts files (name them .mjs): @(StrayJs)" />
  </Target>

</Project>
